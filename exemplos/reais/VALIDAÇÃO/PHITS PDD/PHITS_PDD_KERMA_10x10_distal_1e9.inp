$OMP = 16
$ ^ numero de threads OpenMP. TEM de ser a PRIMEIRA linha do arquivo.
$   Como '$' tambem e' o comentario do PHITS, uma versao que nao entenda esta
$   diretiva simplesmente a ignora -- nao quebra, so roda em 1 thread.
$   Cinto e suspensorio, no console da maquina que roda:
$       set OMP_NUM_THREADS=16

[ Title ]
Varian_mlc_photon_6MV_0deg
$ Traduzido de MCNP_pdd_10x10_distal por mcnp2phits.py
$ Geometria e materiais vem do MCNP 1:1; fonte, fisica e tallies sao
$ equivalentes escritos na sintaxe do PHITS (ver 00_AULAS).
$
$ APAGADO na traducao: o lattice de detectores, que no MCNP e' so' um
$ artificio de pontuacao (as caixinhas sao do MESMO material do tanque,
$ agua). Virou a(s) malha(s) [T-Track] de kerma do fim do arquivo, com os
$ voxels no lugar exato dos detectores. Apagar isso nao move um foton.
$   celulas ....... 702 703 704 705
$   superficies ... 901-903

[ Parameters ]
 icntl    =           0     $ 0 = calculo normal; 7 = so desenha a geometria
 maxcas   =       10000     $ historias por batch
 maxbch   =      100000     $ batches -> maxcas*maxbch = 1e+09 historias (= nps do MCNP)
 negs     =           1     $ 1 = liga o EGS5: transporte acoplado foton/eletron/positron
 emin(12) =         0.1     $ corte de eletron  [MeV]  (equivale a cut:e do MCNP)
 emin(13) =         0.1     $ corte de positron [MeV]
 emin(14) =        0.01     $ corte de foton    [MeV]  (equivale a cut:p do MCNP)
 dmax(12) =        25.0     $ energia maxima das bibliotecas de eletron
 dmax(13) =        25.0
 dmax(14) =        25.0
 ipnint   =           0     $ 0 = sem reacoes fotonucleares (como no deck MCNP)
 nspred   =           2     $ espalhamento multiplo de eletrons (recomendado com EGS5)
 e-mode   =           0
 istdev   =          -1     $ desvio padrao por batch
 itall    =           0
 file(1)  = E:/PHITS/     $ pasta de INSTALACAO do PHITS (--phits-dir)
 file(6)  = phits.out
$ Alternativa explicita, caso file(1) nao resolva. Os caminhos abaixo sao os
$ defaults do PHITS vistos nos .out oficiais do MRCP em 07_MRCP_PHITS/:
$   file(7)  = <instalacao>/data/xsdir.jnd   $ bibliotecas nucleares
$   file(20) = <instalacao>/XS/egs/          $ dados do EGS5 (obrigatorio c/ negs=1)
$ ATENCAO: o EGS5 fica em XS/egs, NAO em data/egs.

[ Source ]
  s-type =   13             $ gaussiana no plano x-y (equivale ao sp -41 do MCNP)
   proj  =   electron
     x0  =   0.0
     y0  =   0.0
     r1  =   0.13           $ FWHM do spot [cm] — mesmo 0.13 cm do deck MCNP
     z0  =  -0.25           $ plano de emissao, logo acima do alvo
     z1  =  -0.25
    dir  =   1.0            $ cosseno diretor em z: feixe descendo o eixo
  e-type =   8              $ distribuicao DISCRETA de energia (equivale a si4 L / sp4 D)
      ne =   61
