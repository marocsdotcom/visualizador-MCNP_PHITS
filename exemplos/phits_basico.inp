[ Title ]
Exemplo PHITS: fantoma de agua com insertos e blindagem

[ Parameters ]
 icntl = 8
 maxcas = 1000

set: c1[15.0]  c2[c1/3]  $ meia-largura do fantoma e raio dos insertos

[ Material ]
MAT[1]  H 2  O 1
MAT[2]  Pb 1
MAT[3]  Ca 1  P 0.6  O 2.6
MAT[4]  N 0.8  O 0.2

[ Surface ]
 10  rpp  -c1 c1  -c1 c1  -c1 c1
 11  sph  -6 0 0  c2
 12  rcc  6 0 -8  0 0 16  c2-1
 13  1 rpp -4 4 -1 1 -12 12
 20  rpp  -30 30  20 25  -20 20
 99  so   80

[ Transform ]
*tr1  0 -9 0   20 70 90  110 20 90  90 90 0

[ Cell ]
 1   3 -1.85   -11
 2   2 -11.35  -12
 3   3 -1.85   -13
 4   1 -1.0    -10 #1 #2 #3
 5   2 -11.35  -20
 6   4 -1.2e-3 -99 10 20
 9   -1        99

[ T-Track ] off
 mesh = xyz

[ End ]
